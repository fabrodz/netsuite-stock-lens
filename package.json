{
  "name": "netsuite-stock-lens",
  "version": "1.0.0",
  "description": "Chrome extension that shows live NetSuite inventory data on hover inside transactions.",
  "type": "module",
  "license": "MIT",
  "author": "Fabian Rodriguez",
  "homepage": "https://github.com/fabrodz/netsuite-stock-lens#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fabrodz/netsuite-stock-lens.git"
  },
  "bugs": {
    "url": "https://github.com/fabrodz/netsuite-stock-lens/issues"
  },
  "keywords": ["netsuite", "chrome-extension", "inventory", "suiteql", "manifest-v3"],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "release": "node scripts/package.mjs",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "biome check --write .",
    "lint:check": "biome check .",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@playwright/test": "^1.49.0",
    "@testing-library/react": "^16.1.0",
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitest/coverage-v8": "^2.1.8",
    "@wxt-dev/module-react": "^1.1.3",
    "autoprefixer": "^10.4.20",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8",
    "wxt": "^0.20.26"
  }
}
